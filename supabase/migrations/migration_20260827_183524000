-- ---------- Policies ----------
create policy "profiles_select" on public.profiles for select using (id = auth.uid() or public.is_staff_office() or public.is_caregiver());
create policy "profiles_insert" on public.profiles for insert with check (public.is_admin());
create policy "profiles_update" on public.profiles for update using (id = auth.uid() or public.is_admin()) with check (id = auth.uid() or public.is_admin());
create policy "profiles_delete" on public.profiles for delete using (public.is_admin());

create policy "clients_select" on public.clients for select using (public.is_staff_office() or public.has_visit_with_client(id) or profile_id = auth.uid());
create policy "clients_insert" on public.clients for insert with check (public.is_management());
create policy "clients_update" on public.clients for update using (public.is_management());
create policy "clients_delete" on public.clients for delete using (public.is_management());

create policy "staff_select" on public.staff for select using (public.is_staff_office() or profile_id = auth.uid());
create policy "staff_insert" on public.staff for insert with check (public.is_admin() or public.is_hr());
create policy "staff_update" on public.staff for update using (public.is_admin() or public.is_hr());
create policy "staff_delete" on public.staff for delete using (public.is_admin() or public.is_hr());

create policy "care_plans_select" on public.care_plans for select using (public.is_staff_office() or public.has_visit_with_client(client_id) or public.is_client_owner(client_id));
create policy "care_plans_insert" on public.care_plans for insert with check (public.is_management());
create policy "care_plans_update" on public.care_plans for update using (public.is_management());
create policy "care_plans_delete" on public.care_plans for delete using (public.is_management());

create policy "care_plan_tasks_select" on public.care_plan_tasks for select using (exists (select 1 from public.care_plans cp where cp.id = care_plan_id and (public.is_staff_office() or public.has_visit_with_client(cp.client_id) or public.is_client_owner(cp.client_id))));
create policy "care_plan_tasks_insert" on public.care_plan_tasks for insert with check (public.is_management());
create policy "care_plan_tasks_update" on public.care_plan_tasks for update using (public.is_management());
create policy "care_plan_tasks_delete" on public.care_plan_tasks for delete using (public.is_management());

create policy "appointments_insert" on public.appointments for insert with check (true);
create policy "appointments_select" on public.appointments for select using (public.is_staff_office() or (client_id is not null and public.is_client_owner(client_id)));
create policy "appointments_update" on public.appointments for update using (public.is_management());
create policy "appointments_delete" on public.appointments for delete using (public.is_management());

create policy "visits_select" on public.visits for select using (public.is_staff_office() or caregiver_id = auth.uid() or public.is_client_owner(client_id));
create policy "visits_insert" on public.visits for insert with check (public.is_management());
create policy "visits_update" on public.visits for update using (public.is_management() or (public.is_caregiver() and caregiver_id = auth.uid()));
create policy "visits_delete" on public.visits for delete using (public.is_management());

create policy "incidents_insert" on public.incidents for insert with check (public.is_staff_office() or public.is_caregiver());
create policy "incidents_select" on public.incidents for select using (public.is_staff_office() or reported_by = auth.uid());
create policy "incidents_update" on public.incidents for update using (public.is_admin() or public.is_care_manager() or public.is_compliance());
create policy "incidents_delete" on public.incidents for delete using (public.is_admin());

create policy "invoices_select" on public.invoices for select using (public.is_staff_office() or public.is_client_owner(client_id));
create policy "invoices_insert" on public.invoices for insert with check (public.is_admin() or public.is_finance());
create policy "invoices_update" on public.invoices for update using (public.is_admin() or public.is_finance());
create policy "invoices_delete" on public.invoices for delete using (public.is_admin() or public.is_finance());

create policy "invoice_items_select" on public.invoice_items for select using (public.is_staff_office() or exists (select 1 from public.invoices i where i.id = invoice_id and public.is_client_owner(i.client_id)));
create policy "invoice_items_insert" on public.invoice_items for insert with check (public.is_admin() or public.is_finance());
create policy "invoice_items_update" on public.invoice_items for update using (public.is_admin() or public.is_finance());
create policy "invoice_items_delete" on public.invoice_items for delete using (public.is_admin() or public.is_finance());

create policy "payments_select" on public.payments for select using (public.is_staff_office() or exists (select 1 from public.invoices i where i.id = invoice_id and public.is_client_owner(i.client_id)));
create policy "payments_insert" on public.payments for insert with check (public.is_admin() or public.is_finance());
create policy "payments_update" on public.payments for update using (public.is_admin() or public.is_finance());
create policy "payments_delete" on public.payments for delete using (public.is_admin() or public.is_finance());

create policy "messages_insert" on public.messages for insert with check (auth.role() = 'authenticated');
create policy "messages_select" on public.messages for select using (sender_id = auth.uid() or receiver_id = auth.uid() or (client_id is not null and public.is_client_owner(client_id)));
create policy "messages_update" on public.messages for update using (sender_id = auth.uid() or receiver_id = auth.uid() or (client_id is not null and public.is_client_owner(client_id)));
create policy "messages_delete" on public.messages for delete using (sender_id = auth.uid() or receiver_id = auth.uid());

create policy "notifications_select" on public.notifications for select using (user_id = auth.uid());
create policy "notifications_insert" on public.notifications for insert with check (public.is_staff_office());
create policy "notifications_update" on public.notifications for update using (user_id = auth.uid());
create policy "notifications_delete" on public.notifications for delete using (user_id = auth.uid());

create policy "documents_select" on public.documents for select using (public.is_staff_office() or owner_id = auth.uid() or (owner_type = 'client' and public.is_client_owner(owner_id)) or (owner_type = 'client' and public.has_visit_with_client(owner_id)));
create policy "documents_insert" on public.documents for insert with check (public.is_staff_office() or owner_id = auth.uid());
create policy "documents_update" on public.documents for update using (public.is_staff_office() or owner_id = auth.uid());
create policy "documents_delete" on public.documents for delete using (public.is_staff_office() or owner_id = auth.uid());

create policy "qualifications_select" on public.qualifications for select using (public.is_staff_office() or exists (select 1 from public.staff s where s.id = staff_id and s.profile_id = auth.uid()));
create policy "qualifications_insert" on public.qualifications for insert with check (public.is_admin() or public.is_hr());
create policy "qualifications_update" on public.qualifications for update using (public.is_admin() or public.is_hr());
create policy "qualifications_delete" on public.qualifications for delete using (public.is_admin() or public.is_hr());

create policy "training_select" on public.training for select using (public.is_staff_office() or exists (select 1 from public.staff s where s.id = staff_id and s.profile_id = auth.uid()));
create policy "training_insert" on public.training for insert with check (public.is_admin() or public.is_hr());
create policy "training_update" on public.training for update using (public.is_admin() or public.is_hr());
create policy "training_delete" on public.training for delete using (public.is_admin() or public.is_hr());

create policy "compliance_select" on public.compliance_records for select using (public.is_staff_office());
create policy "compliance_insert" on public.compliance_records for insert with check (public.is_admin() or public.is_compliance() or public.is_hr());
create policy "compliance_update" on public.compliance_records for update using (public.is_admin() or public.is_compliance() or public.is_hr());
create policy "compliance_delete" on public.compliance_records for delete using (public.is_admin() or public.is_compliance());

create policy "audit_logs_select" on public.audit_logs for select using (public.is_admin() or public.is_compliance());
create policy "audit_logs_insert" on public.audit_logs for insert with check (public.is_admin());

create policy "job_postings_select" on public.job_postings for select using (status = 'open' or public.is_admin() or public.is_hr());
create policy "job_postings_insert" on public.job_postings for insert with check (public.is_admin() or public.is_hr());
create policy "job_postings_update" on public.job_postings for update using (public.is_admin() or public.is_hr());
create policy "job_postings_delete" on public.job_postings for delete using (public.is_admin() or public.is_hr());

create policy "job_applications_insert" on public.job_applications for insert with check (true);
create policy "job_applications_select" on public.job_applications for select using (public.is_admin() or public.is_hr());
create policy "job_applications_update" on public.job_applications for update using (public.is_admin() or public.is_hr());
create policy "job_applications_delete" on public.job_applications for delete using (public.is_admin() or public.is_hr());

create policy "blog_posts_select" on public.blog_posts for select using (status = 'published' or public.is_admin() or public.is_management());
create policy "blog_posts_insert" on public.blog_posts for insert with check (public.is_admin() or public.is_management());
create policy "blog_posts_update" on public.blog_posts for update using (public.is_admin() or public.is_management());
create policy "blog_posts_delete" on public.blog_posts for delete using (public.is_admin() or public.is_management());

create policy "contact_messages_insert" on public.contact_messages for insert with check (true);
create policy "contact_messages_select" on public.contact_messages for select using (public.is_staff_office());
create policy "contact_messages_update" on public.contact_messages for update using (public.is_staff_office());

